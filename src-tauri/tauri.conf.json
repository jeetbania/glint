{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glint",
  "version": "0.1.0",
  "identifier": "cc.jeetcreates.glint",
  "build": {
    "frontendDist": "https://glint-jeetbania.vercel.app",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "..",
      "wait": false
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Glint",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
